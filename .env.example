TENCENTCLOUD_SECRET_ID=your_secret_id
TENCENTCLOUD_SECRET_KEY=your_secret_key
TENCENTCLOUD_REGION=ap-guangzhou

TOKENHUB_API_KEY_IMAGE=your_tokenhub_image_api_key
TOKENHUB_API_KEY_CHAT=your_tokenhub_chat_api_key

# Browser direct upload requires OSS bucket CORS configured in Alibaba Cloud Console.
# Example local origin: http://localhost:3000
# Example production origin: https://ai.winghouse.xyz
# Allowed methods: PUT,GET,HEAD,OPTIONS
# Allowed headers: Content-Type,Origin,Accept,x-oss-*
# Expose headers: ETag,x-oss-request-id
OSS_REGION=oss-cn-guangzhou
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=your_oss_bucket
OSS_ENDPOINT=
OSS_DIR=uploads

HUNYUAN_MAX_POLL_DURATION_MS=300000

# ---- Agent 运行时 ----
# 聊天所使用的模型（TokenHub OpenAI 兼容端点）
AGENT_CHAT_MODEL=deepseek-v4-flash
# Agent 单轮最大推理步数（防止死循环）
AGENT_MAX_ITERATIONS=6
# 自检不达标时最多自动重写几轮（0 = 关闭）
AGENT_REWRITE_ATTEMPTS=1
# 是否允许 Agent 真正触发出图（默认关闭，避免误触消耗额度）
AGENT_ENABLE_GENERATE=false
# 本地无 Key 演示模式：用脚本化 Mock 跑通 Agent 循环（仅调试用）
AGENT_MOCK_LLM=false
